# The docs images (docs/images) and the sources each one shows. Every PNG
# in docs/images needs a row here (make docs-check); a new image also needs
# the owner's OK, and the set stays small (about 15).
#
# make docs-stale lists the images whose sources have commits after the
# image was last captured (docs/tools/stale-images.sh); release-check stops
# a final release while one is stale. Each row is an image and git
# pathspecs (a directory covers everything under it); "*" rows apply to
# every image. Test files never count.
#
# image                      sources
*                            frontend/src/App.tsx frontend/src/theme frontend/src/components/StatusLabel.tsx
*                            docs/tools/mock/fixtures.mjs docs/tools/mock/scenarios.mjs docs/tools/mock/server.mjs
*                            docs/tools/capture.js docs/tools/screenshots.sh
*                            frontend/package.json frontend/package-lock.json frontend/webpack.config.js
*                            frontend/public frontend/src/index.tsx

