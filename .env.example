# Copy to .env and uncomment variables to override defaults.
# All variables are optional; the values shown are the built-in defaults.

# ── Registry & Image ──
# IMAGE=quay.io/juntao_wang/rhoai-nightly-updater
# TAG=latest

# ── Deployment ──
# NAMESPACE=rhoai-nightly-updater

# ── Build ──
# GIT_SHA=<auto>       # auto-detected from git; override for CI builds

# ── Operator Defaults ──
# STABLE_SOURCE=redhat-operators
# STABLE_CHANNEL=           # optional GA channel pin; otherwise discover latest GA from the stable catalog
# DSC_SAMPLE_REF=           # optional Git branch/tag override; otherwise derived from installed CSV

# ── Server ──
# PORT=8080
# BIND_ADDRESS=         # all interfaces; 127.0.0.1 when DEV_MODE=true
# STATIC_DIR=./frontend/dist
# LOG_LEVEL=info        # debug, info, warn, error
# SHUTDOWN_DRAIN_TIMEOUT=16m  # wait for running cluster operations on shutdown

# ── MinIO Credentials ──
# When unset, existing credentials in the minio-secret are reused; on first
# setup "minio" is used as the user and a random password is generated.
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=<random>

# ── Development Only (never set in production) ──
# DEV_MODE=true
# DEV_TOKEN=sha256~xxx  # your oc token (auto-set by dev.sh)
# DEV_USER=kube:admin   # your oc username (auto-set by dev.sh)
